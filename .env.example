# Notion CMS — build-time only. These are never exposed to the browser: the
# fetch script runs in Node, and only its JSON output is bundled.
#
# Anything Vite exposes to the client must be prefixed VITE_. Deliberately,
# nothing below is — do not add that prefix to a token.

# Internal integration secret from https://www.notion.so/profile/integrations
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database IDs — the 32-character segment of the database URL. Each database
# must be shared with the integration above (••• menu -> Connections).
# See scripts/notion/collections.ts for the columns each one needs.
NOTION_GALLERY_DATABASE_ID=
NOTION_PILLARS_DATABASE_ID=
NOTION_EVENTS_DATABASE_ID=
